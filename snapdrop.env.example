# Secrets für snapdrop (ADR 0006) – nie committen.
# Entweder als Umgebungsvariablen setzen oder als Datei mounten und SNAPDROP_ENV_FILE darauf zeigen lassen.

# Öffentliche Basis-URL der App (für den Dropbox-Redirect)
PUBLIC_URL=https://snapdrop.example.org

# Fernet-Schlüssel zum Verschlüsseln der gespeicherten Zugangsdaten:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# Aus der Dropbox App Console (leer lassen = nur ownCloud)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
